# Required to run the Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Postgres (required unless MOCK_DASHBOARD=1)
DATABASE_URL=postgres://rolebot:rolebot@localhost:5432/rolebot

# Optional: register slash commands instantly to one guild
GUILD_ID=

# Optional defaults used by /setup when a guild has no saved settings yet
VERIFY_CHANNEL_ID=
# Existing Discord message to watch. Any reaction on it grants Newbie.
# Right-click the message → Copy Message ID (Developer Mode).
VERIFY_MESSAGE_ID=
BOOSTER_CATEGORY_ID=
# Role granted on that reaction (or bind later with /roles bind rank:newbie)
NEWBIE_ROLE_ID=
LOG_CHANNEL_ID=

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production

# Optional Discord OAuth (magic-link from /dashboard works without this)
DISCORD_CLIENT_SECRET=

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Set true to re-register slash commands on every boot
DEPLOY_COMMANDS=true

# Local UI preview without Discord or Postgres
# MOCK_DASHBOARD=1
