{
  "name": "discord-role-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Discord.js role, channel, and category access manager with a visual dashboard",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/bot/deploy.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "preview:map": "node scripts/preview-map.js",
    "preview:dashboard": "MOCK_DASHBOARD=1 node src/index.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  }
}
